# =========================
# RazorGuard .gitignore
# =========================

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables / secrets
.env
.env.*
!.env.example

# API keys / secret files
*.key
secrets.json

# IDE settings
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Python build files
build/
dist/
*.egg-info/

# Large training datasets
data/
datasets/
*.csv
*.parquet

# Temporary files
*.tmp
*.temp
~*

# Node / frontend dependencies (if applicable)
node_modules/

# Frontend build output
dist/
build/